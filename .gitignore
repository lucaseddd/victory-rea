# Allowlist: ignore everything and let only text through.
# See DATA-POLICY.md. Nothing from the game goes in here.
*
!*/
!.gitignore
!.gitattributes
!LICENSE
!*.md
!*.yml
!*.yaml
!*.json
!*.csv
!*.ps1
!*.py
!*.toml

# Local configuration with machine paths: never committed.
harness.toml
victory.toml

# Even with an allowed extension, these folders never go in.
REA-COORD/
evidence/
evidence-local/
captures/
capturas/
cache/
dist/
run/
target/
fxceless-*/
victory-*/
__pycache__/
.venv/

